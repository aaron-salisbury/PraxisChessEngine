<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>PraxisChessEngine</AssemblyName>
    <Product>Praxis Chess Engine</Product>
    <Description>Hobbyist C# chess engine, to be used to back a chess interface, such as Arena.</Description>
    <Authors>Aaron Salisbury</Authors>
    <Copyright>© Aaron Salisbury</Copyright>
    <RepositoryUrl>https://github.com/aaron-salisbury/PraxisChessEngine</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PraxisChessEngine.Business\PraxisChessEngine.Business.csproj" />
    <ProjectReference Include="..\PraxisChessEngine.Data\PraxisChessEngine.Data.csproj" />
    <ProjectReference Include="..\PraxisChessEngine.Integrations\PraxisChessEngine.Integrations.csproj" />
  </ItemGroup>

</Project>
